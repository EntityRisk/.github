{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(build)",
    "abandonments:recommended",
    ":automergeMinor"
  ],
  "schedule": ["* * * * 0,6"],
  "packageRules": [
    {
      "description": "Get ER packages from Gemfury",
      "matchPackageNames": ["er-**"],
      "registryUrls": ["https://pypi.fury.io/entityrisk/"]
    }
  ]
}
